{
  "name": "strava-to-peakbagger",
  "version": "0.1.0",
  "description": "Chrome extension that syncs Strava activities to peakbagger.com ascents",
  "private": true,
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "fast-xml-parser": "^5.7.3",
    "happy-dom": "^20.9.0",
    "kdbush": "^4.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  }
}
